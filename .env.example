# Local configuration only. For cloud hosting, use Deployment_Guide.md.
# Copy this file to .env and replace both secrets before first launch.
# Generate values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=knight
POSTGRES_USER=knight
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
SQLITE_TEST=0
# On Windows, add STOCKFISH_PATH with your actual .exe location.
# Render installs Stockfish at /usr/games/stockfish automatically.
APP_PORT=8080
# For private LAN multiplayer, set 0.0.0.0 and add the machine IP to hosts/origins.
BIND_ADDRESS=127.0.0.1
