{
  "name": "knight-personal-chess",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "format": "prettier --write frontend/src vite.config.js offline-plugin.js scripts",
    "package:source": "node scripts/package-source.mjs",
    "desktop:dev": "electron .",
    "desktop:package:windows": "npm run build && electron-builder --config desktop/electron-builder.yml --win nsis --x64",
    "desktop:package:linux": "npm run build && electron-builder --config desktop/electron-builder.yml --linux deb --x64"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "chess.js": "^1.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.6.2",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": "24.x"
  },
  "main": "desktop/main.cjs"
}
